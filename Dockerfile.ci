# CI 专用：产物已由 workflow 在原生环境编译好（ci-dist/），镜像内无任何 RUN，
# 因此多架构（amd64/arm64）构建不需要 QEMU 模拟。
# 本地开发请用仓库根目录的 Dockerfile（源码内构建）。
# 注意：本镜像未安装 CJK 字体；「下载水印」的中文署名需要运行环境有字体，
# 使用 CI 镜像时请在派生镜像中安装 fontconfig + font-noto-cjk，否则中文会渲染为方框。
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    DATA_DIR=/data \
    PORT=3000
COPY package.json package-lock.json ./
COPY server/package.json server/
# 版本冲突的依赖（如 @fastify/static）嵌装在 workspace 内，必须一并拷贝
COPY node_modules ./node_modules
COPY server/node_modules ./server/node_modules
COPY server-dist ./server/dist
COPY web-dist ./web/dist
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s \
  CMD wget -qO- http://127.0.0.1:3000/health || exit 1
CMD ["node", "server/dist/index.js"]
